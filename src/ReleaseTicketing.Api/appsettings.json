{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": ""
  },

  "Business": {
    "BusinessTimeZone": "Asia/Kolkata"
  },

  "Attachments": {
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".msg",
      ".eml",
      ".png",
      ".jpg",
      ".jpeg"
    ],
    "MaxFileSizeBytes": 10485760,
    "Container": "release-attachments",
    "StorageAccountUrl": "",
    "LocalFolder": "local-attachments"
  },

  "Graph": {
    "Enabled": false,
    "SenderUser": ""
  },

  "Notifications": {
    "BatchSize": 50,
    "MaxRetries": 5,
    "BaseRetryMinutes": 5,
    "AppUrl": "https://apex.example.com/release-requests"
  }
}