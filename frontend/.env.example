# Frontend origin must also be registered as a SPA redirect URI in Entra ID.
VITE_RELEASE_API_URL=https://your-release-api.example.com
VITE_ENTRA_TENANT_ID=your-tenant-guid
VITE_ENTRA_SPA_CLIENT_ID=your-spa-app-client-guid
VITE_ENTRA_API_SCOPE=api://your-api-app-client-guid/access_as_user
VITE_AUTH_MODE=entra